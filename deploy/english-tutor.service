[Unit]
Description=English Tutor (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/english-tutor/backend
ExecStart=/home/ubuntu/.local/bin/uv run --no-dev --frozen uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
# keep the process from being OOM-killed before swap is used
MemoryHigh=1700M

[Install]
WantedBy=multi-user.target
