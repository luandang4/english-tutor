# Copy to .env and fill in. Never commit .env.

# Required — Gemini (conversation, lessons, grading). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required — Azure Speech, used ONLY for pronunciation scoring. Leave empty to hide that feature.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Optional overrides (defaults shown)
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db   (default: SQLite at <project>/data/app.db)
# CONTENT_MODELS=["gemini-3.5-flash","gemini-3.8-flash","gemini-3.5-flash-lite"]
# GRADING_MODELS=["gemini-3.5-flash-lite","gemini-3.5-flash"]
# WRITING_MODELS=["gemini-3.5-flash","gemini-3.8-flash"]
# LIVE_MODEL=gemini-3.8-live
# TTS_WORD_SOURCES=["google","dictionary","kokoro"]
# TTS_SENTENCE_SOURCES=["kokoro","google"]
# TTS_VOICE=af_heart        (Kokoro voices: af_bella, af_sarah, am_michael, …)
# TTS_SPEED=0.95
# TTS_CACHE_MAX_MB=1024     (audio cache cap: oldest files deleted first)
# TTS_CACHE_MAX_DAYS=30     (audio files older than this are deleted)
# MAX_LIVE_SESSION_MINUTES=30
# LIVE_END_OF_SPEECH_MS=1200  (silence that ends a learner turn; higher = Emma waits longer)
# LIVE_PRONUNCIATION=true     (score each spoken turn with Azure, needs AZURE_SPEECH_KEY)
# TIMEZONE=Asia/Ho_Chi_Minh

# Accounts
# COOKIE_SECURE=false         # set true when served over HTTPS
# SESSION_DAYS=30

# Pronunciation scoring engine: azure (default) | local (free on-server phoneme model, an estimate)
# | auto (Azure, falling back to local when Azure is out of quota / unreachable).
# The local model is built with backend/scripts/export_phoneme_model.py (~356 MB, ~800 MB RAM while loaded).
# PRONUNCIATION_ENGINE=azure
# PHONEME_IDLE_UNLOAD_SECONDS=600
