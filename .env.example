# Copy to .env and fill in. Never commit .env.

# Required — Gemini (conversation, lessons, grading). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — Azure Speech, used ONLY for pronunciation scoring. Leave empty to hide that feature.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Optional overrides (defaults shown)
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db   (default: SQLite at <project>/data/app.db)
# CONTENT_MODELS=["gemini-3.5-flash","gemini-3.8-flash","gemini-3.5-flash-lite"]
# GRADING_MODELS=["gemini-3.5-flash-lite","gemini-3.5-flash"]
# WRITING_MODELS=["gemini-3.5-flash","gemini-3.8-flash"]
# LIVE_MODEL=gemini-3.8-live
# TTS_WORD_SOURCES=["google","dictionary","kokoro"]
# TTS_SENTENCE_SOURCES=["kokoro","google"]
# TTS_VOICE=af_heart        (Kokoro voices: af_bella, af_sarah, am_michael, …)
# TTS_SPEED=0.95
# MAX_LIVE_SESSION_MINUTES=30
# TIMEZONE=Asia/Ho_Chi_Minh

# Accounts
# ALLOW_REGISTRATION=true     # set false after creating your accounts
# COOKIE_SECURE=false         # set true when served over HTTPS
# SESSION_DAYS=30
